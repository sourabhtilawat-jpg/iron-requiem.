{
  "name": "iron-requiem",
  "version": "0.2.0",
  "description": "Iron Requiem - a WWII first-person shooter",
  "main": "electron/main.cjs",
  "author": "Iron Requiem Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.3",
    "@fontsource/oswald": "^5.0.0",
    "@fontsource/special-elite": "^5.0.0",
    "three": "0.160.0",
    "three-mesh-bvh": "^0.7.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@gltf-transform/cli": "^4.5.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ironrequiem.game",
    "productName": "Iron Requiem",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
